# ===== 调试 =====
# 流式请求轨迹落盘开关（user -> agent -> model）：
# false/0/off 关闭；true/1/on 写入 logs/stream-chunks.jsonl；
# 也可以直接填文件路径（相对 server 目录或绝对路径）
STREAM_CHUNK_LOG=1

# ===== 模型服务 =====
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 单次请求超时（毫秒）与 SDK 重试次数上限
DEEPSEEK_TIMEOUT_MS=120000
DEEPSEEK_MAX_RETRIES=1

# ===== HTTP =====
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ===== 上下文工程 =====
# full | window | summary-window
CONTEXT_STRATEGY=window
CONTEXT_MAX_TOKENS=8000
CONTEXT_MAX_MESSAGES=20
CONTEXT_RESERVE_OUTPUT=1024
CONTEXT_SUMMARY_THRESHOLD=0.6
CONTEXT_SUMMARY_KEEP_TURNS=4
CONTEXT_SUMMARY_MAX_TOKENS=800
# 留空使用内置 system prompt
CONTEXT_SYSTEM_PROMPT=

# ===== 长期记忆（默认关闭，开启后每轮会多一次小模型调用） =====
MEMORY_ENABLED=false
MEMORY_LIMIT=5
MEMORY_BUDGET_RATIO=0.15

# ===== 知识库（留空表示不启用） =====
KNOWLEDGE_DIR=
KNOWLEDGE_TOP_K=4
KNOWLEDGE_BUDGET_RATIO=0.25
